{
  "build": {
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build && pnpm backend:build",
    "devPath": "http://localhost:1420",
    "distDir": "../ui/dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "AssetFurnace",
    "version": "1.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": false,
        "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|([A-Z]:\\\\|/|~/).*)"
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "scope": [
          "$APPDATA/assetfurnace/*",
          "$RESOURCE/*"
        ]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": false,
        "message": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "Copyright © 2025 Asset Furnace",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.assetfurnace.app",
      "longDescription": "One-Click Digital Asset Factory - An autonomous, schema-driven pipeline that generates complete digital product bundles for marketplaces like Etsy and Gumroad.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [
        "../backend/bin/main.dist"
      ],
      "shortDescription": "Digital Asset Factory",
      "targets": [
        "updater"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "AssetFurnace",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720
      }
    ]
  }
}