{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assets Output Schema",
  "description": "Output schema for the Maker agent",
  "type": "object",
  "required": ["generated_assets", "metadata", "qa_report"],
  "properties": {
    "generated_assets": {
      "type": "array",
      "description": "List of generated assets",
      "items": {
        "type": "object",
        "required": ["name", "path", "size"],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Marketplace metadata",
      "properties": {
        "etsy": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 140
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 13
            },
            "price": {
              "type": "number",
              "minimum": 0.20
            }
          }
        },
        "gumroad": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "price": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "qa_report": {
      "$ref": "#/definitions/qa_report"
    }
  },
  "definitions": {
    "qa_report": {
      "type": "object",
      "required": ["status", "score", "checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "warning"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks": {
          "type": "object",
          "properties": {
            "assets_complete": {
              "type": "boolean"
            },
            "metadata_valid": {
              "type": "boolean"
            },
            "file_sizes_ok": {
              "type": "boolean"
            },
            "naming_convention": {
              "type": "boolean"
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
