{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bundle Plan Schema",
  "description": "Output schema for the Planner agent",
  "type": "object",
  "required": ["niche", "title", "description", "pricing", "assets", "target_persona", "tags", "marketplaces"],
  "properties": {
    "niche": {
      "type": "string",
      "description": "Selected niche"
    },
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "pricing": {
      "type": "object",
      "required": ["base_price", "suggested_price", "premium_price"],
      "properties": {
        "base_price": {
          "type": "number",
          "minimum": 0
        },
        "suggested_price": {
          "type": "number",
          "minimum": 0
        },
        "premium_price": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "List of assets to generate",
      "items": {
        "type": "object",
        "required": ["type", "name", "format"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["template", "guide", "worksheet", "checklist", "infographic", "other"]
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": ["PDF", "PNG", "JPG", "SVG", "DOCX", "XLSX", "TXT"]
          }
        }
      }
    },
    "target_persona": {
      "type": "object",
      "required": ["age_range", "occupation", "pain_points"],
      "properties": {
        "age_range": {
          "type": "string"
        },
        "occupation": {
          "type": "string"
        },
        "pain_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "marketplaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["etsy", "gumroad", "creative_market", "design_cuts"]
      }
    }
  }
}
