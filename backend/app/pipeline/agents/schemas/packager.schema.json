{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package Output Schema",
  "description": "Output schema for the Packager agent",
  "type": "object",
  "required": ["bundle_id", "output_path", "created_at"],
  "properties": {
    "bundle_id": {
      "type": "string",
      "description": "Unique bundle identifier"
    },
    "output_path": {
      "type": "string",
      "description": "Path to final ZIP file"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_size": {
      "type": "integer",
      "minimum": 0
    },
    "asset_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
