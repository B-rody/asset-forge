    "target_persona": {
      "age_range": "",
      "occupation": "",
      "pain_points": [],
      "goals": [],
      "technical_skill_level": ""
    },
    "brand_voice": {
      "tone": "",
      "style": "",
      "language_level": "",
      "terms_to_avoid": []
    },
    "content_guidelines": {
      "formatting_rules": [],
      "visual_style": "",
      "accessibility_requirements": []
    }
  },

  "asset_to_create": {
    "asset_id": "",
    "type": "",
    "name": "",
    "description": "",
    "content_specs": {
      "sections": [],
      "features": [],
      "page_count": 0,
      "additional_notes": ""
    },
    "format": "",
    "target_file_size_mb": 0,
    "includes_fillable_fields": false
  },

  "generation_preferences": {
    "quality_level": "high",
    "optimization": {
      "compress_images": true,
      "optimize_file_sizes": true,
      "target_total_size_mb": 25
    },
    "formatting": {
      "use_professional_fonts": true,
      "consistent_styling": true,
      "accessibility_compliant": true
    }
  },

  "qa_thresholds": {
    "minimum_completeness_score": 0.90,
    "minimum_quality_score": 0.85,
    "fail_on_missing_sections": true,
    "fail_on_format_mismatch": true
  },

  "file_naming": {
    "pattern": "{asset_id}_{name}.{format}",
    "use_lowercase": true,
    "use_hyphens_not_spaces": true
  },

  "constraints": {
    "max_file_size_mb": 50,
    "max_generation_time_seconds": 300,
    "supported_formats": ["PDF", "PNG", "JPG", "SVG", "DOCX", "XLSX", "TXT", "MD", "CSV", "HTML", "NOTION"]
  }
}
